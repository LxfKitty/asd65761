function 推断紧凑订阅目标(请求) {
  const UA = String(请求.headers.get('User-Agent') || '').toLowerCase();
  if (/clash|mihomo|stash/.test(UA)) return 'clash';
  if (/sing-box|singbox/.test(UA)) return 'singbox';
  if (/surge/.test(UA)) return 'surge';
  if (/quantumult/.test(UA)) return 'quanx';
  if (/loon/.test(UA)) return 'loon';
  return '';
}

function 紧凑每日散列(文本) {
  let h = 2166136261;
  for (let i = 0; i < 文本.length; i++) { h ^= 文本.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}

function 尝试解码订阅文本(文本) {
  const 值 = String(文本 || '').trim();
  if (!值 || 值.includes('://') || 值.includes('\n')) return 值;
  if (!/^[A-Za-z0-9+/_=-]+$/.test(值)) return 值;
  try {
    const 标准 = 值.replace(/-/g, '+').replace(/_/g, '/');
    const 二进制 = atob(标准.padEnd(Math.ceil(标准.length / 4) * 4, '='));
    const 字节 = Uint8Array.from(二进制, c => c.charCodeAt(0));
    const 解码 = new TextDecoder().decode(字节);
    return 解码.includes('://') || 解码.includes('\n') ? 解码 : 值;
  } catch (_) { return 值; }
}

async function 获取紧凑自定义源(源文本, 唯一标识, 工作器域名) {
  const 网址列表 = String(源文本 || '').split(/[\n,;|]+/).map(v => v.trim()).filter(v => /^https?:\/\//i.test(v)).slice(0, 5);
  if (!网址列表.length) return [];
  const 结果 = [];
  const 响应列表 = await Promise.allSettled(网址列表.map(async 网址 => {
    const 控制器 = new AbortController();
    const 计时器 = setTimeout(() => 控制器.abort(), 4500);
    try {
      const 响应 = await fetch(网址, { signal: 控制器.signal, headers: { 'Accept': 'text/plain,*/*;q=0.8' } });
      if (!响应.ok) throw new Error(`HTTP ${响应.status}`);
      return 尝试解码订阅文本(await 响应.text());
    } finally { clearTimeout(计时器); }
  }));
  for (const 项目 of 响应列表) {
    if (项目.status !== 'fulfilled') continue;
    const 地址记录 = [];
    for (const 原行 of String(项目.value || '').replace(/\r/g, '').split('\n')) {
      const 行 = 原行.trim();
      if (!行 || 行.startsWith('#') || 行.startsWith('//')) continue;
      if (/^(vless|trojan|ss):\/\//i.test(行)) { 结果.push(行); continue; }
      const 匹配 = 行.match(/^(\[[^\]]+\]|[^:#\s]+)(?::(\d+))?(?:#(.*))?$/);
      if (!匹配) continue;
      const ip = 匹配[1].replace(/^\[|\]$/g, '');
      const 端口 = parseInt(匹配[2] || '443', 10);
      if (!ip || !Number.isFinite(端口) || 端口 < 1 || 端口 > 65535) continue;
      地址记录.push({ ip, 端口, name: (匹配[3] || '自定义汇聚').trim() });
      if (地址记录.length >= 80) break;
    }
    if (地址记录.length) 结果.push(...从新地址生成链接(地址记录, 唯一标识, 工作器域名));
    if (结果.length >= 200) break;
  }
  return [...new Set(结果)].slice(0, 200);
}

async function 处理订阅请求(请求, 唯一标识, 网址 = null) {
  if (!网址) 网址 = new URL(请求.url);
  const 模式 = String(网址.searchParams.get('bestmode') || 'smart').toLowerCase();
  const 目标 = String(网址.searchParams.get('target') || 'raw').toLowerCase();
  const 最终链接列表 = [];
  const 工作器域名 = 网址.hostname;

  if (模式 === 'custom') {
    最终链接列表.push(...await 获取紧凑自定义源(网址.searchParams.get('source') || '', 唯一标识, 工作器域名));
  } else {
    const 原生列表 = [{ ip: 工作器域名, isp: '原生地址' }];
    最终链接列表.push(...从来源生成链接(原生列表, 唯一标识, 工作器域名));
    if (启用其他优选) {
      const 域名列表 = 直连域名列表.map(d => ({ ip: d.domain, isp: d.name || d.domain }));
      最终链接列表.push(...从来源生成链接(域名列表, 唯一标识, 工作器域名));
    }
    if (启用仓库优选) {
      const 新地址列表 = await 拉取并解析新地址();
      if (新地址列表.length > 0) 最终链接列表.push(...从新地址生成链接(新地址列表, 唯一标识, 工作器域名));
    }
  }

  let 去重列表 = [...new Set(最终链接列表)];
  if (模式 === 'random' && 去重列表.length > 1) {
    const 日期 = new Date().toISOString().slice(0, 10);
    去重列表 = 去重列表.slice().sort((a, b) => 紧凑每日散列(`${日期}|${a}`) - 紧凑每日散列(`${日期}|${b}`));
  }
  if (去重列表.length === 0) {
    const 错误备注 = '所有节点获取失败';
    去重列表.push(`${解码64('dmxlc3M=')}://00000000-0000-0000-0000-000000000000@127.0.0.1:80?encryption=none&security=none&type=ws&host=error.com&path=%2F#${encodeURIComponent(错误备注)}`);
  }

  if (目标 === 'link' || 目标 === 'node') {
    const 首节点 = 去重列表.find(v => /^(vless|trojan|ss):\/\//i.test(v)) || 去重列表[0];
    return new Response(首节点, { headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' } });
  }

  if (目标 === 'auto') {
    const 自动目标 = 推断紧凑订阅目标(请求);
    if (自动目标) {
      try {
        const 原始网址 = new URL(网址.toString());
        原始网址.searchParams.set('target', 'raw');
        const 转换网址 = `${订阅转换接口}?target=${encodeURIComponent(自动目标)}&url=${encodeURIComponent(原始网址.toString())}&insert=false`;
        const 转换响应 = await fetch(转换网址, { headers: { 'User-Agent': 'CFnew-Compact-Adaptive/3.0' } });
        if (转换响应.ok) return new Response(await 转换响应.arrayBuffer(), { headers: { 'Content-Type': 转换响应.headers.get('Content-Type') || 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' } });
      } catch (_) {}
    }
  }

  const 订阅内容 = btoa(去重列表.join('\n'));
  return new Response(订阅内容, { headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0' } });
}

function 从来源生成链接(列表, 唯一标识, 工作器域名) {
  const 传输层安全端口列表 = [443];
  const 链接列表 = [];
  const 网页套接字路径 = '/?ed=2048';
  const 协议 = 解码64('dmxlc3M=');

  列表.forEach(项 => {
    const 节点名基础 = 项.isp.replace(/\s/g, '_');
    const 安全地址 = 项.ip.includes(':') ? `[${项.ip}]` : 项.ip;

    传输层安全端口列表.forEach(端口 => {
      const 网页套接字节点名 = `${节点名基础}-${端口}-WS-TLS`;
      const 网页套接字参数 = new URLSearchParams({
        encryption: 'none',
        security: 'tls',
        sni: 工作器域名,
        fp: 'randomized',
        type: 'ws',
        host: 工作器域名,
        path: 网页套接字路径
      });
      链接列表.push(`${协议}://${唯一标识}@${安全地址}:${端口}?${网页套接字参数.toString()}#${encodeURIComponent(网页套接字节点名)}`);
    });
  });

  return 链接列表;
}

async function 拉取并解析新地址() {
  const 网址 = 仓库优选网址;
  try {
    const 响应 = await fetch(网址);
    if (!响应.ok) return [];
    const 文本 = await 响应.text();
    const 结果列表 = [];
    const 行列表 = 文本.trim().replace(/\r/g, "").split('\n');
    const 正则 = /^([^:]+):(\d+)#(.*)$/;

    for (const 行 of 行列表) {
      const 整理行 = 行.trim();
      if (!整理行) continue;
      const 匹配 = 整理行.match(正则);
      if (匹配) {
        结果列表.push({
          ip: 匹配[1],
          端口: parseInt(匹配[2], 10),
          name: 匹配[3].trim() || 匹配[1]
        });
      }
    }
    return 结果列表;
  } catch (error) {
    return [];
  }
}

function 从新地址生成链接(列表, 唯一标识, 工作器域名) {
  const 链接列表 = [];
  const 网页套接字路径 = '/?ed=2048';
  const 协议 = 解码64('dmxlc3M=');

  列表.forEach(项 => {
    const 节点名 = 项.name;
    const 安全地址 = 项.ip.includes(':') ? `[${项.ip}]` : 项.ip;
    const 参数 = {
      encryption: 'none',
      security: 'tls',
