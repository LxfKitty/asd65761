  };
  return 邻近映射[地区] || [];
}

function 获取优先地区列表(地区) {
  const 邻近地区列表 = 获取邻近地区(地区);
  const 全部地区列表 = ['US', 'SG', 'JP', 'HK', 'KR', 'DE', 'SE', 'NL', 'FI', 'GB'];
  return [地区, ...邻近地区列表, ...全部地区列表.filter(r => r !== 地区 && !邻近地区列表.includes(r))];
}

function 获取智能地区选择(工作器地区, 可用地址列表) {
  if (!启用地区匹配 || !工作器地区) return 可用地址列表;
  const 优先地区列表 = 获取优先地区列表(工作器地区);
  const 排序地址列表 = [];
  for (const 地区 of 优先地区列表) {
    const 地区地址列表 = 可用地址列表.filter(地址项 => 地址项.regionCode === 地区);
    排序地址列表.push(...地区地址列表);
  }
  return 排序地址列表;
}

function 获取备用健康键(地址项) {
  return `${String(地址项?.domain || '').toLowerCase()}:${Number(地址项?.端口 || 443)}`;
}

function 获取备用健康项(地址项) {
  const 键 = 获取备用健康键(地址项);
  if (!备用地址健康状态.has(键)) 备用地址健康状态.set(键, { success: 0, fail: 0, latency: null, cooldownUntil: 0, lastSuccess: 0, lastFailure: 0 });
  return 备用地址健康状态.get(键);
}

function 记录备用结果(地址项, 成功, 延迟 = null) {
  if (!地址项) return;
  const 状态 = 获取备用健康项(地址项);
  const 现在 = Date.now();
  if (成功) {
    状态.success += 1;
    状态.fail = Math.max(0, 状态.fail - 1);
    状态.lastSuccess = 现在;
    状态.cooldownUntil = 0;
    if (Number.isFinite(延迟)) 状态.latency = 状态.latency == null ? 延迟 : Math.round(状态.latency * 0.7 + 延迟 * 0.3);
  } else {
    状态.fail += 1;
    状态.lastFailure = 现在;
    if (状态.fail >= 2) 状态.cooldownUntil = 现在 + Math.min(15 * 60_000, 30_000 * (2 ** Math.min(5, 状态.fail - 2)));
  }
  if (备用地址健康状态.size > 64) {
    const 最旧 = [...备用地址健康状态.entries()].sort((a, b) => Math.max(a[1].lastSuccess, a[1].lastFailure) - Math.max(b[1].lastSuccess, b[1].lastFailure))[0];
    if (最旧) 备用地址健康状态.delete(最旧[0]);
  }
}

function 获取备用候选地址(工作器地区 = '', 数量 = 稳定回退候选数) {
  if (备用地址列表.length === 0) return [];
  const 现在 = Date.now();
  const 地区顺序 = 获取优先地区列表(工作器地区 || 'HK');
  const 地区排名 = new Map(地区顺序.map((值, 索引) => [值, 索引]));
  return 备用地址列表.map(地址项 => {
    const 状态 = 获取备用健康项(地址项);
    const 冷却 = 状态.cooldownUntil > 现在;
    const 地区分 = 地区排名.has(地址项.regionCode) ? 地区排名.get(地址项.regionCode) : 99;
    const 健康分 = 状态.success * 12 - 状态.fail * 18 - (状态.latency == null ? 0 : Math.min(30, 状态.latency / 50));
    return { ...地址项, __冷却: 冷却, __地区分: 地区分, __健康分: 健康分 };
  }).sort((甲, 乙) => Number(甲.__冷却) - Number(乙.__冷却) || 甲.__地区分 - 乙.__地区分 || 乙.__健康分 - 甲.__健康分)
    .slice(0, Math.max(1, Math.min(备用地址列表.length, 数量)))
    .map(({ __冷却, __地区分, __健康分, ...地址项 }) => 地址项);
}

async function 获取最佳备用地址(工作器地区 = '') {
