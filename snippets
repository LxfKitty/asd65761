      host: 工作器域名,
      path: 网页套接字路径
    };
    const 网页套接字参数 = new URLSearchParams(参数);
    链接列表.push(`${协议}://${唯一标识}@${安全地址}:${项.端口}?${网页套接字参数.toString()}#${encodeURIComponent(节点名)}`);
  });

  return 链接列表;
}

async function 处理网页套接字请求(请求, 当前回退地址 = null) {
  const 网页套接字对 = new WebSocketPair();
  const [客户端套接字, 服务端套接字] = Object.values(网页套接字对);
  服务端套接字.accept();

  let 远程连接包装 = { 套接字: null, generation: 0, connectingPromise: null, responseHeader: null, activeCandidate: null };
  let 域名系统处理器 = null;
  let 握手缓冲 = new Uint8Array(0);
  const 握手缓冲上限 = 16384;

  const 回退地址值 = 当前回退地址 || 回退地址;

  const 早期数据 = 请求.headers.get('sec-websocket-protocol') || '';
  const 可读流 = 创建可读流(服务端套接字, 早期数据);

  可读流.pipeTo(new WritableStream({
    async write(数据块) {
      const 当前数据 = 数据块 instanceof Uint8Array ? 数据块 : new Uint8Array(数据块);
      if (域名系统处理器) {
        await 域名系统处理器.write(当前数据);
        return;
      }
      if (!远程连接包装.套接字 && 远程连接包装.connectingPromise) {
        try { await 远程连接包装.connectingPromise; } catch (忽略) {}
      }
      if (远程连接包装.套接字) {
        const 当前远程 = 远程连接包装.套接字;
        const 写入器 = 当前远程.writable.getWriter();
        try { await 写入器.write(当前数据); }
        finally { try { 写入器.releaseLock(); } catch (忽略) {} }
        return;
      }

      if (握手缓冲.byteLength) {
        const 合并数据 = new Uint8Array(握手缓冲.byteLength + 当前数据.byteLength);
        合并数据.set(握手缓冲);
        合并数据.set(当前数据, 握手缓冲.byteLength);
        握手缓冲 = 合并数据;
      } else {
        握手缓冲 = 当前数据.slice();
      }
      if (握手缓冲.byteLength > 握手缓冲上限) throw new Error('Protocol header is too large');

      const { 是否有错误, 需要更多数据, 消息, 地址类型, 端口, 主机名, 原始索引, 版本, 是否用户数据报 } = 解析套接字包头(握手缓冲, 认证令牌);
      if (是否有错误) {
        if (需要更多数据) return;
        throw new Error(消息);
      }

      if (是否用户数据报 && 端口 !== 53) throw new Error(错误_仅支持域名系统用户数据报);
      const 响应头 = new Uint8Array([版本[0], 0]);
      const 原始数据 = 握手缓冲.slice(原始索引);
      握手缓冲 = new Uint8Array(0);

      if (是否用户数据报) {
        域名系统处理器 = 创建域名系统处理器(服务端套接字, 响应头);
        await 域名系统处理器.write(原始数据);
        return;
      }
      await 转发传输控制(地址类型, 主机名, 端口, 原始数据, 服务端套接字, 响应头, 远程连接包装, 回退地址值);
    },
  })).catch((err) => { console.log('WS Stream Error:', err); });

  return new Response(null, { status: 101, webSocket: 客户端套接字 });
}

async function 转发传输控制(地址类型参数, 主机, 端口数字, 原始数据, 网页套接字, 响应头, 远程连接包装, 回退地址值 = null) {
  远程连接包装.responseHeader = 响应头;

  async function 连接并发送(地址, 端口) {
    const 远程套接字 = connect({ hostname: 地址, port: 端口 });
    await 等待套接字打开(远程套接字, 稳定拨号超时);
    const 写入器 = 远程套接字.writable.getWriter();
    try { if (原始数据?.byteLength) await 写入器.write(原始数据); }
    catch (错误) { try { 远程套接字.close?.(); } catch (忽略) {} throw 错误; }
    finally { try { 写入器.releaseLock(); } catch (忽略) {} }
    return 远程套接字;
  }

  const 候选 = [];
  const 已见 = new Set();
  function 加入候选(地址, 端口, 健康项 = null, 标签 = 'fallback') {
    if (!地址) return;
    const 键 = `${String(地址).toLowerCase()}:${Number(端口 || 端口数字)}`;
    if (已见.has(键) || 键 === `${String(主机).toLowerCase()}:${Number(端口数字)}`) return;
    已见.add(键);
    候选.push({ 地址, 端口: Number(端口 || 端口数字), 健康项, 标签 });
  }

  const 显式回退 = 回退地址值 || 回退地址;
  if (显式回退 && 显式回退.trim()) {
    const 解析值 = 解析地址和端口(显式回退.trim());
    加入候选(解析值.地址, 解析值.端口 || 端口数字, null, 'explicit');
  }
  for (const 地址项 of 获取备用候选地址(当前工作器地区, 稳定回退候选数)) 加入候选(地址项.domain, 地址项.端口 || 端口数字, 地址项, 地址项.regionCode || 'region');

  let 候选索引 = -1;
  async function 安装连接(地址, 端口, 健康项 = null, 标签 = 'direct') {
    const 本代 = ++远程连接包装.generation;
    const 旧套接字 = 远程连接包装.套接字;
    远程连接包装.套接字 = null;
    远程连接包装.activeCandidate = { 地址, 端口, 标签 };
    if (旧套接字) try { 旧套接字.close?.(); } catch (忽略) {}
    const 开始 = Date.now();
    const 套接字 = await 连接并发送(地址, 端口);
    if (本代 !== 远程连接包装.generation) { try { 套接字.close?.(); } catch (忽略) {} throw new Error('stale connection generation'); }
    远程连接包装.套接字 = 套接字;
    const 是否当前 = () => 远程连接包装.generation === 本代 && 远程连接包装.套接字 === 套接字;
    const 获取响应头 = () => {
      const 头 = 远程连接包装.responseHeader;
      if (头) 远程连接包装.responseHeader = null;
      return 头;
    };
    void 连接流(套接字, 网页套接字, 获取响应头, 重试连接, 是否当前, () => {
      if (健康项) 记录备用结果(健康项, true, Date.now() - 开始);
    }, () => {
      if (健康项) 记录备用结果(健康项, false);
    });
    return 套接字;
  }

  async function 重试连接() {
    if (远程连接包装.connectingPromise) return 远程连接包装.connectingPromise;
    远程连接包装.connectingPromise = (async () => {
      while (++候选索引 < 候选.length) {
        const 当前 = 候选[候选索引];
        try {
          await 安装连接(当前.地址, 当前.端口, 当前.健康项, 当前.标签);
          return true;
        } catch (错误) {
          if (当前.健康项) 记录备用结果(当前.健康项, false);
        }
      }
      ++远程连接包装.generation;
      远程连接包装.套接字 = null;
      if (网页套接字.readyState === 1) 安静关闭套接字(网页套接字);
      return false;
    })();
    try { return await 远程连接包装.connectingPromise; }
    finally { 远程连接包装.connectingPromise = null; }
  }

  try {
    await 安装连接(主机, 端口数字, null, 'direct');
  } catch (错误) {
    await 重试连接();
  }
}

function 解析套接字包头(数据块, 令牌) {
  const 字节 = 数据块 instanceof Uint8Array ? 数据块 : new Uint8Array(数据块);
  if (字节.byteLength < 24) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
  const 版本 = 字节.subarray(0, 1);
  try {
    if (格式化标识(字节, 1) !== 令牌) return { 是否有错误: true, 消息: 错误_无效用户 };
  } catch (错误) {
    return { 是否有错误: true, 消息: 错误_无效用户 };
  }
  const 选项长度 = 字节[17];
  const 命令索引 = 18 + 选项长度;
  if (字节.byteLength < 命令索引 + 5) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
  const 命令 = 字节[命令索引];
  let 是否用户数据报 = false;
  if (命令 === 1) { }
  else if (命令 === 2) { 是否用户数据报 = true; }
  else { return { 是否有错误: true, 消息: 错误_不支持命令 }; }

  const 端口索引 = 19 + 选项长度;
  const 端口 = 字节[端口索引] << 8 | 字节[端口索引 + 1];
  let 地址索引 = 端口索引 + 2, 地址长度 = 0, 地址值索引 = 地址索引 + 1, 主机名 = '';
  const 地址类型 = 字节[地址索引];

  switch (地址类型) {
    case 地址类型_四版:
      地址长度 = 4;
      if (字节.byteLength < 地址值索引 + 地址长度) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
      主机名 = 字节.subarray(地址值索引, 地址值索引 + 地址长度).join('.');
      break;
    case 地址类型_网址:
      if (字节.byteLength < 地址值索引 + 1) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
      地址长度 = 字节[地址值索引++];
      if (字节.byteLength < 地址值索引 + 地址长度) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
      主机名 = new TextDecoder().decode(字节.subarray(地址值索引, 地址值索引 + 地址长度));
      break;
    case 地址类型_六版:
      地址长度 = 16;
      if (字节.byteLength < 地址值索引 + 地址长度) return { 是否有错误: true, 需要更多数据: true, 消息: 错误_无效数据 };
      const 六版地址段 = [];
      const 六版视图 = new DataView(字节.buffer, 字节.byteOffset + 地址值索引, 地址长度);
      for (let i = 0; i < 8; i++) 六版地址段.push(六版视图.getUint16(i * 2).toString(16));
      主机名 = 六版地址段.join(':');
      break;
    default:
      return { 是否有错误: true, 消息: `${错误_无效地址类型}: ${地址类型}` };
  }

  if (!主机名) return { 是否有错误: true, 消息: `${错误_空地址}: ${地址类型}` };
  return { 是否有错误: false, 地址类型, 端口, 主机名, 是否用户数据报, 原始索引: 地址值索引 + 地址长度, 版本 };
}

function 创建可读流(套接字, 早期数据头) {
  let 已取消 = false;
  return new ReadableStream({
    start(控制器) {
      套接字.addEventListener('message', (事件) => { if (!已取消) 控制器.enqueue(事件.data); });
      套接字.addEventListener('close', () => { if (!已取消) { 安静关闭套接字(套接字); 控制器.close(); } });
      套接字.addEventListener('error', (err) => 控制器.error(err));
      const { 早期数据, error } = 基础64转数组(早期数据头);
      if (error) 控制器.error(error);
      else if (早期数据) 控制器.enqueue(早期数据);
    },
    cancel() { 已取消 = true; 安静关闭套接字(套接字); }
  });
}

async function 连接流(远程套接字, 网页套接字, 获取头数据, 重试函数, 是否当前 = () => true, 首字节成功 = null, 首字节失败 = null) {
  let 是否有数据 = false;
  let 已触发重试 = false;
  let 读取器 = null;
  let 计时器 = null;

  async function 触发重试() {
    if (已触发重试 || !是否当前()) return false;
    已触发重试 = true;
    try { 首字节失败?.(); } catch (忽略) {}
    try { 远程套接字.close?.(); } catch (忽略) {}
    if (!重试函数) {
      if (网页套接字.readyState === 1) 安静关闭套接字(网页套接字);
      return false;
    }
    try { return !!(await 重试函数()); }
    catch (忽略) { if (网页套接字.readyState === 1) 安静关闭套接字(网页套接字); return false; }
  }

  计时器 = setTimeout(() => { if (!是否有数据 && 是否当前()) void 触发重试(); }, 稳定首字节超时);
  try {
    读取器 = 远程套接字.readable.getReader();
    for (;;) {
      const { value, done } = await 读取器.read();
      if (done) break;
      if (!是否当前()) break;
      const 数据块 = value instanceof Uint8Array ? value : new Uint8Array(value);
      if (!数据块.byteLength) continue;
      if (!是否有数据) {
        是否有数据 = true;
        if (计时器) { clearTimeout(计时器); 计时器 = null; }
        try { 首字节成功?.(); } catch (忽略) {}
        const 头 = typeof 获取头数据 === 'function' ? 获取头数据() : 获取头数据;
        if (网页套接字.readyState !== 1) throw new Error(错误_网页套接字未打开);
        if (头) 网页套接字.send(await new Blob([头, 数据块]).arrayBuffer());
        else 网页套接字.send(数据块);
      } else {
        if (网页套接字.readyState !== 1) throw new Error(错误_网页套接字未打开);
        网页套接字.send(数据块);
      }
    }
  } catch (错误) {
    if (是否当前()) {
      if (!是否有数据) await 触发重试();
      else if (!已触发重试 && 网页套接字.readyState === 1) 安静关闭套接字(网页套接字);
    }
  } finally {
    if (计时器) clearTimeout(计时器);
    try { 读取器?.releaseLock(); } catch (忽略) {}
  }
  if (!是否当前()) return;
  if (!是否有数据) {
    if (await 触发重试()) return;
  }
  if (!已触发重试 && 网页套接字.readyState === 1) 安静关闭套接字(网页套接字);
}

function 提取用户数据报帧(状态, 块) {
  const 新数据 = 块 instanceof Uint8Array ? 块 : new Uint8Array(块);
  let 数据;
  if (状态.buffer && 状态.buffer.byteLength) {
    数据 = new Uint8Array(状态.buffer.byteLength + 新数据.byteLength);
    数据.set(状态.buffer);
    数据.set(新数据, 状态.buffer.byteLength);
  } else {
    数据 = 新数据.slice();
  }
  if (数据.byteLength > 262144) throw new Error('VLESS UDP buffer overflow');
  const 数据报列表 = [];
  let 偏移 = 0;
  while (数据.byteLength - 偏移 >= 2) {
    const 长度 = 数据[偏移] << 8 | 数据[偏移 + 1];
    if (长度 <= 0) throw new Error('Invalid VLESS UDP frame length');
    if (数据.byteLength - 偏移 - 2 < 长度) break;
    数据报列表.push(数据.slice(偏移 + 2, 偏移 + 2 + 长度));
    偏移 += 2 + 长度;
  }
  状态.buffer = 偏移 < 数据.byteLength ? 数据.slice(偏移) : new Uint8Array(0);
  if (状态.buffer.byteLength > 65537) throw new Error('VLESS UDP frame is too large');
  return 数据报列表;
}
function 封装用户数据报响应(数据报, 响应头 = null) {
  const 数据 = 数据报 instanceof Uint8Array ? 数据报 : new Uint8Array(数据报);
  if (!数据.byteLength || 数据.byteLength > 65535) throw new Error('Invalid DNS response size');
  const 头长度 = 响应头 ? 响应头.byteLength : 0;
  const 输出 = new Uint8Array(头长度 + 2 + 数据.byteLength);
  let 偏移 = 0;
  if (响应头) { 输出.set(响应头, 0); 偏移 = 头长度; }
  输出[偏移] = 数据.byteLength >> 8 & 255;
  输出[偏移 + 1] = 数据.byteLength & 255;
  输出.set(数据, 偏移 + 2);
  return 输出;
}
async function 查询域名系统HTTPS(查询数据) {
  let 最后错误 = null;
  for (const 端点 of ['https://1.1.1.1/dns-query', 'https://8.8.8.8/dns-query']) {
    try {
      const 响应 = await fetch(端点, {
        method: 'POST',
        headers: { 'content-type': 'application/dns-message', 'accept': 'application/dns-message' },
        body: 查询数据
      });
      if (!响应.ok) throw new Error(`DoH ${响应.status}`);
      const 数据 = new Uint8Array(await 响应.arrayBuffer());
      if (!数据.byteLength || 数据.byteLength > 65535) throw new Error('Invalid DoH response');
      return 数据;
    } catch (错误) { 最后错误 = 错误; }
  }
  throw 最后错误 || new Error('DNS over HTTPS failed');
}
function 创建域名系统处理器(网页套接字, 响应头) {
  const 状态 = { buffer: new Uint8Array(0) };
  let 首次响应 = true;
  let 顺序链 = Promise.resolve();
  async function 处理块(块) {
    for (const 查询数据 of 提取用户数据报帧(状态, 块)) {
      const 响应数据 = await 查询域名系统HTTPS(查询数据);
      if (网页套接字.readyState !== 1) throw new Error(错误_网页套接字未打开);
      网页套接字.send(封装用户数据报响应(响应数据, 首次响应 ? 响应头 : null));
      首次响应 = false;
    }
  }
  return { write(块) { 顺序链 = 顺序链.then(() => 处理块(块)); return 顺序链; } };
}

function 基础64转数组(基础64文本) {
  if (!基础64文本) return { error: null };
  try {
    基础64文本 = 基础64文本.replace(/-/g, '+').replace(/_/g, '/');
    return { 早期数据: Uint8Array.from(atob(基础64文本), (c) => c.charCodeAt(0)).buffer, error: null };
  } catch (error) {
    return { error };
  }
}

function 是否有效格式(唯一标识) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(唯一标识);
}

function 安静关闭套接字(套接字) {
  try { if (套接字.readyState === 1 || 套接字.readyState === 2) 套接字.close(); }
  catch (error) { }
}

const 十六进制表 = Array.from({ length: 256 }, (v, i) => (i + 256).toString(16).slice(1));

function 格式化标识(数组, 偏移 = 0) {
  const 标识 = (
    十六进制表[数组[偏移]] + 十六进制表[数组[偏移 + 1]] + 十六进制表[数组[偏移 + 2]] + 十六进制表[数组[偏移 + 3]] + "-" +
    十六进制表[数组[偏移 + 4]] + 十六进制表[数组[偏移 + 5]] + "-" +
    十六进制表[数组[偏移 + 6]] + 十六进制表[数组[偏移 + 7]] + "-" +
    十六进制表[数组[偏移 + 8]] + 十六进制表[数组[偏移 + 9]] + "-" +
    十六进制表[数组[偏移 + 10]] + 十六进制表[数组[偏移 + 11]] + 十六进制表[数组[偏移 + 12]] + 十六进制表[数组[偏移 + 13]] +
    十六进制表[数组[偏移 + 14]] + 十六进制表[数组[偏移 + 15]]
  ).toLowerCase();
  if (!是否有效格式(标识)) throw new TypeError(错误_无效标识字符串);
  return 标识;
}
